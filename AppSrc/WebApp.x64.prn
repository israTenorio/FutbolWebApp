38381>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38384>>>        WebSet pbRender of oNewButton to True
38385>>>        WebSet pbRender of oDetailButton to True
38386>>>
38386>>>        Case Begin
38386>>>            Case (NavigateData.eNavigateType = nfFromParent)
38388>>>                // If from parent, this is a constrained drill down
38388>>>                Case Break
38389>>>
38389>>>            Case (NavigateData.eNavigateType = nfFromChild)
38392>>>                // If from child, this is a probably a parent lookup from a Zoom
38392>>>                Case Break
38393>>>
38393>>>            Case (NavigateData.eNavigateType = nfFromMain)
38396>>>                // If from main, this is a probably a main-file lookup from a Zoom
38396>>>                WebSet pbRender of oDetailButton to False
38397>>>                Case Break
38398>>>
38398>>>            Case Else // must be nfUndefined
38398>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38398>>>
38398>>>        Case End
38398>>>
38398>>>    End_Procedure
38399>>>
38399>>>
38399>>>End_Object 
