38896>>>>>        WebSet pbRender of oEditBtn to False
38897>>>>>        WebSet pbRender of oSaveBtn to False
38898>>>>>        WebSet pbRender of oCancelChangesBtn to False
38899>>>>>        WebSet pbRender of oDeleteBtn to False
38900>>>>>
38900>>>>>        If (NavigateData.bReadOnly) Begin
38902>>>>>            WebSet pbRender of oEditBtn to True
38903>>>>>        End
38903>>>>>>
38903>>>>>        Else Begin
38904>>>>>            WebSet pbRender of oSaveBtn to True
38905>>>>>            WebSet pbRender of oCancelChangesBtn to True
38906>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38907>>>>>        End
38907>>>>>>
38907>>>>>    End_Procedure
