38951>>>>>        WebSet pbRender of oSaveBtn to False
38952>>>>>        WebSet pbRender of oCancelChangesBtn to False
38953>>>>>        WebSet pbRender of oDeleteBtn to False
38954>>>>>
38954>>>>>        If (NavigateData.bReadOnly) Begin
38956>>>>>            WebSet pbRender of oEditBtn to True
38957>>>>>        End
38957>>>>>>
38957>>>>>        Else Begin
38958>>>>>            WebSet pbRender of oSaveBtn to True
38959>>>>>            WebSet pbRender of oCancelChangesBtn to True
38960>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38961>>>>>        End
38961>>>>>>
38961>>>>>    End_Procedure
