37848>>>                // If from parent, this is a constrained drill down
37848>>>                Case Break
37849>>>
37849>>>            Case (NavigateData.eNavigateType = nfFromChild)
37852>>>                // If from child, this is a probably a parent lookup from a Zoom
37852>>>                Case Break
37853>>>
37853>>>            Case (NavigateData.eNavigateType = nfFromMain)
37856>>>                // If from main, this is a probably a main-file lookup from a Zoom
37856>>>                WebSet pbRender of oDetailButton to False
37857>>>                Case Break
37858>>>
37858>>>            Case Else // must be nfUndefined
37858>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
37858>>>
37858>>>        Case End
37858>>>
37858>>>    End_Procedure
