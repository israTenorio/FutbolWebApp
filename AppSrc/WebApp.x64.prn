36710>>>>>>>                Get CNG_PBKDF2_HMAC "SHA256" (StringToUCharArray(sPassword)) ucaSalt uiOptTimeCost (&ucaHash) False to bOk
36711>>>>>>>                If (not(bOk)) Function_Return False
36714>>>>>>>                
36714>>>>>>>                Move True to bRequireTimeCost
36715>>>>>>>                Case Break
36716>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36719>>>>>>>                Get CNG_PBKDF2_HMAC "SHA512" (StringToUCharArray(sPassword)) ucaSalt uiOptTimeCost (&ucaHash) False to bOk
36720>>>>>>>                If (not(bOk)) Function_Return False
36723>>>>>>>                
36723>>>>>>>                Move True to bRequireTimeCost
36724>>>>>>>                Case Break
36725>>>>>>>            Case Else
36725>>>>>>>                Error 8710 "Invalid algorithm selected."
36726>>>>>>>>
36726>>>>>>>                Function_Return False
36727>>>>>>>        Case End
36727>>>>>>>        
36727>>>>>>>        String sSalt
36727>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36728>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return False
36731>>>>>>>        Get Base64EncodeArr ucaHash to sHash
36732>>>>>>>        If (not(SizeOfString(sHash))) Function_Return False
36735>>>>>>>        
36735>>>>>>>        If (bRequireTimeCost) Begin
36737>>>>>>>            Move (SFormat("%1$%2$%3$%4",            ;                            String(uiAlgo),         ;                            sSalt,                  ;                            String(uiOptTimeCost),  ;                            sHash)) to sHash
36738>>>>>>>        End
36738>>>>>>>>
36738>>>>>>>        Else Begin
36739>>>>>>>            Move (SFormat("%1$%2$%3",               ;                            String(uiAlgo),         ;                            sSalt,                  ;                            sHash)) to sHash
36740>>>>>>>        End
36740>>>>>>>>
36740>>>>>>>        
36740>>>>>>>        Function_Return bOk
36741>>>>>>>    End_Function
36742>>>>>>>    
36742>>>>>>>    Function CreatePasswordHashEx UInteger uiAlgo UInteger uiSaltSize String sPassword String ByRef sHash UInteger uiOptTimeCost Returns Boolean
36744>>>>>>>        UChar[] ucaSalt
36745>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36746>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36749>>>>>>>        
36749>>>>>>>        If (num_arguments > 4) Begin
36751>>>>>>>            Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash, uiOptTimeCost))
36752>>>>>>>        End
36752>>>>>>>>
36752>>>>>>>        Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash))
36753>>>>>>>    End_Function
36754>>>>>>>    
36754>>>>>>>    Function VerifyPasswordHash String sPassword String sHash Returns Boolean
36756>>>>>>>        Boolean bRequiresTimeCost
36756>>>>>>>        UInteger uiAlgo uiTimeCost
36756>>>>>>>        Integer iBegin iEnd
36756>>>>>>>        String sSalt
36756>>>>>>>        
36756>>>>>>>        Move 1 to iBegin
36757>>>>>>>        
36757>>>>>>>        // Parse Algo
36757>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36758>>>>>>>        If (not(iEnd)) Function_Return False
36761>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiAlgo
36762>>>>>>>        
36762>>>>>>>        // Parse Salt
36762>>>>>>>        Move (iEnd + 1) to iBegin
36763>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36764>>>>>>>        If (not(iEnd)) Function_Return False
36767>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to sSalt
36768>>>>>>>        
36768>>>>>>>        Case Begin
36768>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36770>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36773>>>>>>>                Move True to bRequiresTimeCost
36774>>>>>>>                Case Break
36775>>>>>>>            Case Else
36775>>>>>>>                Error 8710 "Invalid algorithm selected."
36776>>>>>>>>
36776>>>>>>>                Function_Return False
36777>>>>>>>        Case End
36777>>>>>>>        
36777>>>>>>>        // Parse optional timecost
36777>>>>>>>        If (bRequiresTimeCost) Begin
36779>>>>>>>            Move (iEnd + 1) to iBegin
36780>>>>>>>            Move (Pos("$", sHash, iBegin)) to iEnd
36781>>>>>>>            If (not(iEnd)) Function_Return False
36784>>>>>>>            Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiTimeCost
36785>>>>>>>        End
36785>>>>>>>>
36785>>>>>>>        
36785>>>>>>>        // Parse rest hash
36785>>>>>>>        Move (iEnd + 1) to iBegin
36786>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36787>>>>>>>        If (iEnd) Function_Return False // inverse check if there are any other errors.
36790>>>>>>>        
36790>>>>>>>        // Base64Decode
36790>>>>>>>        UChar[] ucaSalt
36791>>>>>>>        Get Base64DecodeArr sSalt to ucaSalt
36792>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36795>>>>>>>        
36795>>>>>>>        // Create new hash
36795>>>>>>>        String sNewHash
36795>>>>>>>        If (bRequiresTimeCost) Begin
36797>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash, uiTimeCost))) Begin
36799>>>>>>>                Function_Return False 
36800>>>>>>>            End
36800>>>>>>>>
36800>>>>>>>        End
36800>>>>>>>>
36800>>>>>>>        Else Begin
36801>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash))) Begin
36803>>>>>>>                Function_Return False 
36804>>>>>>>            End
36804>>>>>>>>
36804>>>>>>>        End
36804>>>>>>>>
36804>>>>>>>        Function_Return (sNewHash = sHash)
36805>>>>>>>    End_Function
36806>>>>>>>    
36806>>>>>>>    Function RequiredBufferSizeEx UInteger uiAlgo UInteger uiSaltSize UInteger uiOptTimeCost Returns UBigInt
36808>>>>>>>        Boolean bRequireTimeCost
36808>>>>>>>        UBigInt ullSize
36808>>>>>>>        UChar[] ucaSalt
36809>>>>>>>        String sSalt
36809>>>>>>>        
36809>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36810>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36811>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return 0
36814>>>>>>>        
36814>>>>>>>        Case Begin
36814>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36816>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA256" to ullSize
36817>>>>>>>                Move True to bRequireTimeCost
36818>>>>>>>                Case Break
36819>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36822>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA512" to ullSize
36823>>>>>>>                Move True to bRequireTimeCost
36824>>>>>>>                Case Break
36825>>>>>>>            Case Else
36825>>>>>>>                Error 8710 "Invalid algorithm selected."
36826>>>>>>>>
36826>>>>>>>                Function_Return 0
36827>>>>>>>        Case End
36827>>>>>>>        
36827>>>>>>>        // calculate base64 in a non-floating-manner
36827>>>>>>>        Move (((ullSize + 3 -1) / 3) * 4) to ullSize
36828>>>>>>>        
36828>>>>>>>        Move (ullSize + SizeOfString(String(uiAlgo))) to ullSize
36829>>>>>>>        Move (ullSize + SizeOfString(sSalt)) to ullSize
36830>>>>>>>        If (bRequireTimeCost) Begin
36832>>>>>>>            Move (ullSize + SizeOfString(String(uiOptTimeCost))) to ullSize
36833>>>>>>>            Move (ullSize + 3 /*$*/) to ullSize
36834>>>>>>>        End
36834>>>>>>>>
36834>>>>>>>        Else Begin
36835>>>>>>>            Move (ullSize + 2 /*$*/) to ullSize
36836>>>>>>>        End
36836>>>>>>>>
36836>>>>>>>        
36836>>>>>>>        Function_Return ullSize
36837>>>>>>>    End_Function
36838>>>>>>>End_Class
36839>>>>>>>
36839>>>>>>>Class cPasswordHasher is a cObject
36840>>>>>>>    
36840>>>>>>>    Import_Class_Protocol cPasswordHasher_Mixin
36841>>>>>>>    
36841>>>>>>>    Procedure Construct_Object
36843>>>>>>>        Forward Send Construct_Object
36845>>>>>>>        
36845>>>>>>>        Property UInteger   peAlgorithm         C_PWH_PBKDF2_HMAC_SHA_512 
36846>>>>>>>        Property UInteger   puiSaltSize         16
36847>>>>>>>        
36847>>>>>>>        Property UInteger   puiOptTimeCost      420000
36848>>>>>>>    End_Procedure
36849>>>>>>>    
36849>>>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36851>>>>>>>        Boolean bOk
36851>>>>>>>        UInteger uiAlgo
36851>>>>>>>        Get peAlgorithm to uiAlgo
36852>>>>>>>        
36852>>>>>>>        Case Begin
36852>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36854>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36857>>>>>>>                Get CreatePasswordHashEx uiAlgo (puiSaltSize(Self)) sPassword (&sHash) (puiOptTimeCost(Self)) to bOk
36858>>>>>>>                Case Break
36859>>>>>>>            Case Else
36859>>>>>>>                Error 8710 "Invalid algorithm selected."
36860>>>>>>>>
36860>>>>>>>                Function_Return False
36861>>>>>>>        Case End
36861>>>>>>>        
36861>>>>>>>        Function_Return bOk
36862>>>>>>>    End_Function
36863>>>>>>>    
36863>>>>>>>    Function RequiredBufferSize Returns UBigInt
36865>>>>>>>        UBigInt ullSize
36865>>>>>>>        UInteger uiAlgo
36865>>>>>>>        Get peAlgorithm to uiAlgo
36866>>>>>>>        
36866>>>>>>>        Case Begin
36866>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36868>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36871>>>>>>>                Get RequiredBufferSizeEx uiAlgo (puiSaltSize(Self)) (puiOptTimeCost(Self)) to ullSize
36872>>>>>>>                Case Break
36873>>>>>>>            Case Else
36873>>>>>>>                Error 8710 "Invalid algorithm selected."
36874>>>>>>>>
36874>>>>>>>                Function_Return 0
36875>>>>>>>        Case End
36875>>>>>>>        
36875>>>>>>>        Function_Return ullSize
36876>>>>>>>    End_Function
36877>>>>>>>
36877>>>>>>>End_Class
