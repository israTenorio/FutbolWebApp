37858>>>                // If from child, this is a probably a parent lookup from a Zoom
37858>>>                Case Break
37859>>>
37859>>>            Case (NavigateData.eNavigateType = nfFromMain)
37862>>>                // If from main, this is a probably a main-file lookup from a Zoom
37862>>>                WebSet pbRender of oDetailButton to False
37863>>>                Case Break
37864>>>
37864>>>            Case Else // must be nfUndefined
37864>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
37864>>>
37864>>>        Case End
37864>>>
37864>>>    End_Procedure
